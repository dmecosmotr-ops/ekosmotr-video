# Copy to .env on the server. Do not put the password or Xiaomi tokens here.
PILOT_IMAGE=ekosmotr-camera-pilot:review
PILOT_PUBLIC_ORIGIN=https://camera.example.invalid
PILOT_ADMIN_EMAIL=admin@example.invalid
PILOT_ADMIN_PASSWORD_FILE_HOST=./deploy/secrets/admin-password.txt
PILOT_PUBLISHED_PORT=3210
PILOT_CPUS=1.0
PILOT_MEMORY_LIMIT=512m
# Concurrent manual live sessions for the whole cabinet (1-150).
# Increase only with the optional video runtime and measured resource limits.
PILOT_LIVE_MAX_STREAMS=1
