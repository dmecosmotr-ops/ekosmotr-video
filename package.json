{
  "name": "ekosmotr-camera-pilot-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "start": "node backend/server.mjs",
    "check:release": "node tools/check-release.mjs",
    "test": "node --test tests/*.test.mjs frontend/*.test.mjs deploy/*.test.mjs",
    "test:python": "python -m unittest discover -s tests -p test_*.py",
    "build": "pnpm --dir frontend run build"
  }
}
